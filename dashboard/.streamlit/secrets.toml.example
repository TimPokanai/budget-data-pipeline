# Copy to dashboard/.streamlit/secrets.toml for local development (gitignored,
# same rule as .env and dbt/profiles.yml -- never commit real credentials).
# For deployment, paste the equivalent TOML into Streamlit Community Cloud's
# App settings -> Secrets instead of ever committing this file filled in.
#
# Mirrors dbt/profiles.yml.example's local/neon split -- one more place
# using the same target vocabulary as --env/--target/--url elsewhere in
# this project, just relocated to the config surface Streamlit itself
# reads (see docs/phase-5-dashboard.md).
#
# Both connections authenticate as `budget_dashboard`, the read-only role
# created by db/grant_dashboard_readonly.sql -- never budget_admin. This
# app has no code path that writes to the database; using a read-only role
# means Postgres enforces that even if it somehow did.

target = "local"

[connections.local]
dialect = "postgresql"
host = "localhost"
port = 5432
database = "budget_data_pipeline"
username = "budget_dashboard"
password = "YOUR_LOCAL_DASHBOARD_PASSWORD"

[connections.neon]
dialect = "postgresql"
host = "YOUR_NEON_ENDPOINT.neon.tech"
port = 5432
database = "budget_data_pipeline"
username = "budget_dashboard"
password = "YOUR_NEON_DASHBOARD_PASSWORD"
sslmode = "require"
