# Local Docker Postgres (docker compose up -d), used for development/testing.
# POSTGRES_PASSWORD is read directly by docker-compose.yml to initialize the
# container -- DATABASE_URL must use that same password, since it's how the
# migration tool and ingestion script connect to that same container. User
# and database name are fixed by docker-compose.yml (budget_admin / budget_pipeline).
#
# Values are quoted, and placeholders avoid `<`/`>` -- this file gets both
# `source`d directly in your shell (per the README's setup guide) and read
# by Docker Compose. Unquoted `<placeholder>` text is parsed by the shell as
# input/output redirection, not literal characters, and breaks `source`.
POSTGRES_PASSWORD="change-me-local-dev-password"
DATABASE_URL="postgres://budget_admin:change-me-local-dev-password@localhost:5432/budget_pipeline?sslmode=disable"

# Neon free-tier serverless Postgres -- the always-addressable copy used by
# scheduled pipeline runs (Phase 4) and any deployed dashboard (Phase 5).
# Get this from your Neon project dashboard; keep sslmode=require. Safe to
# leave as the placeholder below until you're actually running with
# `--env neon` -- it won't break `source .env`, it'll just fail to connect
# if you try to use it before filling it in.
NEON_DATABASE_URL="postgres://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_ENDPOINT.neon.tech/YOUR_NEON_DBNAME?sslmode=require"
