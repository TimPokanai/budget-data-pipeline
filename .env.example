# --- Local Docker Postgres ---
POSTGRES_PASSWORD=localdev
DATABASE_URL=postgres://budget_admin:localdev@localhost:5432/budget_pipeline?sslmode=disable

# --- Neon (always-on, free tier) ---
# Get this from your Neon project dashboard: https://console.neon.tech
NEON_DATABASE_URL=postgres://<user>:<password>@<endpoint>.neon.tech/budget_pipeline?sslmode=require

# --- dbt (Phase 3) ---
# dbt-postgres needs discrete connection fields, not a single URL, so the
# Neon connection above is repeated here unpacked into individual pieces --
# same Neon project, same credentials. Local dbt runs reuse
# POSTGRES_PASSWORD above and need nothing new; see dbt/profiles.yml.example.
NEON_PGHOST=<endpoint>.neon.tech
NEON_PGUSER=<user>
NEON_PGPASSWORD=<password>
NEON_PGDATABASE=budget_pipeline
